# Public source allowlist. Snapshots, logs, reports and runtimes stay local.
*
!/.gitignore
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/package.json
!/package-lock.json
!/src/
!/src/**
/src/scanner/bin/
/src/scanner/obj/
/src/search-native/bin/
/src/search-native/obj/
!/scripts/
!/scripts/**
!/tests/
!/tests/*.test.cjs
!/tests/scanner-contract.cjs
!/tests/product-e2e.cjs
!/tests/search-e2e.cjs
!/assets/
!/assets/spacelens.ico
!/assets/spacelens.png
!/assets/demo/
!/assets/demo/**
!/.github/
!/.github/**
!/licenses/
!/licenses/Electron-LICENSE.txt
!/licenses/Everything-LICENSE.txt
!/licenses/DotNet-LICENSE.txt
!/licenses/DotNet-ThirdPartyNotices.txt
!/docs/
!/docs/OPEN_SOURCE.md
